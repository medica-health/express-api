# Application Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/cdac_db

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdac_db

# Allowed front-end origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# API Keys (if applicable)
API_KEY=
JWT_SECRET=
