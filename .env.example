# Application Port
PORT=5000

# Node Environment (development | test | production)
NODE_ENV=development

# MongoDB (medical record files in GridFS + audit logs)
MONGO_URI=mongodb://localhost:27017/cdac_db

# PostgreSQL + PostGIS (main database; spring-api owns the auth schema, this API owns app)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdac_db

# Allowed front-end origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# JWT issued by spring-api (HS256). Must be identical in both APIs, at least 32 chars.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ISSUER=cdac-auth
JWT_AUDIENCE=cdac-api

# Email via Resend (https://resend.com/api-keys). Leave empty to only log emails locally.
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
MAIL_FROM=MediCare <onboarding@resend.dev>
MAIL_REPLY_TO=
# SMS via Twilio, used instead of email for phone-registered patients (placeholder
# p-<hex>@phone.medicare.invalid addresses). Leave SID/token empty to only log SMS locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: a Messaging Service SID (preferred; used when set) or a Twilio number in E.164
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# Base URL of the web app, used for links in emails
APP_BASE_URL=http://localhost:3000

# Redis (optional): slot holds, free-slot cache, rate limiting. Leave empty to turn those off;
# booking still works without Redis (Postgres prevents double booking).
REDIS_URL=redis://localhost:6379/0
# How long a picked slot is held while the patient confirms (30-900 s)
SLOT_HOLD_TTL_SECONDS=300
# Free-slot cache lifetime; writes invalidate it immediately, the TTL is a safety net
SLOT_CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true

# Run background jobs (24h appointment reminders) in this process
JOBS_ENABLED=true

API_KEY=
